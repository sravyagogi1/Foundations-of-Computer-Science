#1
def sum_n(n):
    if n == 0 :
        return n
    else:
        return n + sum_n(n - 1)

#2   
def sum_squares(n):
    if n == 0 :
        return 0
    else:
        return n ** 2 + sum_squares(n-1)
    
#3
def sum_even(n):
    if n == 0 :
        return  0
    elif n % 2 == 0 :
        return n + sum_even(n-2)
    elif n % 2 == 1 :
        return n-1 + sum_even(n-3)

#4
def count_threes(n):
    if n < 3:
        return 0
    else:
        return 1 + count_threes(n-3)

#5
def sum_m_to_n(m,n):
    if n == m:
        return n
    else:
        return n + sum_m_to_n(m,n-1)

#6
def product_m_to_n(m,n):
    if n == m:
        return n
    else:
      return n * product_m_to_n(m,n-1)
    
