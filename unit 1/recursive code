def mult_3_5(n):
    if n % 3 == 0 :
        return False
    elif n % 5 == 0 :
        return False
    else:
        return True
def sum_3_5(n):
    if n == 0:
        return 0
    elif  mult_3_5(n):
        return n + sum_3_5(n-1)
    elif not mult_3_5(n):
        return sum_3_5(n-1)
